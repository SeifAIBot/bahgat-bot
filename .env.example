# Copy to .env and fill. NEVER commit .env.
TELEGRAM_BOT_TOKEN=
OWNER_ID=
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional extra providers (router v6) — leave empty to skip a provider.
# Cerebras: https://console.cerebras.ai (free-tier status disputed — see config/providers.yaml)
CEREBRAS_API_KEY=
# NVIDIA NIM: https://build.nvidia.com (trial terms: testing/evaluation only, not production)
NVIDIA_API_KEY=
# OpenRouter: https://openrouter.ai/keys (unfunded :free models, 50 req/day)
OPENROUTER_API_KEY=
# Optional
ALLOWED_CHAT_IDS=
LOG_LEVEL=INFO
# YouTube cookies (FALLBACK ONLY — v1.1). Leave empty: downloads use the
# Android player client and need no cookies. Set to the path of a
# Netscape-format cookies.txt on the host ONLY if downloads still fail
# with YouTube's bot-check AND Seif has approved the cookies route.
# The cookies MUST come from a THROWAWAY Google/YouTube account created
# for the bot — never from Seif's own account. See docs/YOUTUBE_COOKIES.md
# for how to create/export/refresh it.
# Note: when this is set, yt-dlp uses the web client + cookies (the
# Android client cannot take cookies), so a STALE cookies file can make
# downloads worse — remove this var to go back to Android-only.
YT_COOKIES_FILE=
# Where runtime state lives (bahgat.db, heartbeat.json, downloads/, voice/).
# Default: <project root>/data. On Northflank set BAHGAT_DATA_DIR=/data so
# the SQLite DB lives on the persistent volume (see docs/DEPLOY-NORTHFLANK.md).
BAHGAT_DATA_DIR=
# Drop Telegram's pending-update backlog on startup (default true). Set to
# false on a host that sleeps/restarts often (Northflank) so messages sent
# while the bot was down are delivered on wake instead of discarded.
DROP_PENDING_UPDATES=true
# Port for the /healthz HTTP endpoint (Northflank injects $PORT itself).
PORT=8080
# Cloudflare WARP egress for YouTube downloads (v1.10). Default ON: the
# bot enrols a free WARP identity (wgcf, no account/email/card) at first
# boot, persists the profile under data/warp/ (the /app/data volume),
# and routes ONLY yt-dlp downloads through wireproxy's SOCKS5 on
# 127.0.0.1:1080. Search, Telegram and LLM traffic stay direct.
# Set WARP_ENABLED=false to roll back to direct downloads (no code
# revert, just a redeploy). WARP_REENROLL: set to a NEW value to delete
# the current identity and re-register once (max 3 enrolments total) —
# the dice roll when the current egress gets flagged by YouTube.
# WARP_PROXY_URL overrides the proxy (operator-provided external proxy).
WARP_ENABLED=true
WARP_REENROLL=
WARP_PROXY_URL=

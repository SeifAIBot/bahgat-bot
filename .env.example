# Copy to .env and fill. NEVER commit .env.
TELEGRAM_BOT_TOKEN=
OWNER_ID=
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional extra providers (router v6) — leave empty to skip a provider.
# Cerebras: https://console.cerebras.ai (free-tier status disputed — see config/providers.yaml)
CEREBRAS_API_KEY=
# NVIDIA NIM: https://build.nvidia.com (trial terms: testing/evaluation only, not production)
NVIDIA_API_KEY=
# OpenRouter: https://openrouter.ai/keys (unfunded :free models, 50 req/day)
OPENROUTER_API_KEY=
# Optional
ALLOWED_CHAT_IDS=
LOG_LEVEL=INFO
# Where runtime state lives (bahgat.db, heartbeat.json, downloads/, voice/).
# Default: <project root>/data. On Northflank set BAHGAT_DATA_DIR=/data so
# the SQLite DB lives on the persistent volume (see docs/DEPLOY-NORTHFLANK.md).
BAHGAT_DATA_DIR=
# Drop Telegram's pending-update backlog on startup (default true). Set to
# false on a host that sleeps/restarts often (Northflank) so messages sent
# while the bot was down are delivered on wake instead of discarded.
DROP_PENDING_UPDATES=true
# Port for the /healthz HTTP endpoint (Northflank injects $PORT itself).
PORT=8080

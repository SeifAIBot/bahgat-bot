# Copy to .env and fill. NEVER commit .env. Secrets live in env vars only.
TELEGRAM_BOT_TOKEN=
OWNER_ID=

# LLM providers — the fallback chain and its order live in
# config/providers.yaml. Fill every key you have; each provider you skip is
# simply left out of the chain, and the bot needs at least one.
#   Groq        https://console.groq.com
#   NVIDIA NIM  https://build.nvidia.com          (trial terms: evaluation only)
#   Gemini      https://aistudio.google.com
# (v2.2: Cerebras and OpenRouter are OUT by owner call — skip both.)
GROQ_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=

# Optional LLM overrides (the chain in config/providers.yaml works without
# any of these):
#   LLM_CHAIN=groq-120b,gemini-3.5-flash-lite   try these, in this order
#   LLM_PROVIDER=gemini                          move a family to the front
#                                                (the rest still backs it up)
#   LLM_MODEL= / LLM_BASE_URL= / LLM_API_KEY=    retarget the first entry only

# Optional
ALLOWED_CHAT_IDS=
LOG_LEVEL=INFO
# Voice: base URL of the SEPARATE RVC worker (character voice). Empty =
# Edge TTS generic voice only. The worker is a different service, never
# part of this container; any worker failure falls back to Edge TTS.
RVC_URL=
# YouTube: egress proxy for yt-dlp (e.g. a WARP wireproxy at
# socks5://127.0.0.1:1080). Empty = direct. Non-fatal when unset/fails.
# The PO-token provider (bgutil) also honours YT_DLP_POT_PROVIDER_URL
# when set (env var, read by yt-dlp directly).
YTDLP_PROXY_URL=
# Runtime state dir (bahgat.db, downloads/, voice/, bot.log). Default
# <project root>/data. On a PaaS point it at the persistent volume.
BAHGAT_DATA_DIR=
# Drop Telegram's pending-update backlog on startup (default true). Set to
# false on a host that sleeps/restarts often so messages sent while the bot
# was down are delivered on wake.
DROP_PENDING_UPDATES=true
# Port for the /healthz endpoint (most PaaS inject $PORT themselves).
PORT=8080
